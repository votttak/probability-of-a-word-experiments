# Matched prefix pilot for n-gram (N), context-limited (C), and internal-layer
# (L) surprisal over the exact ten models with completed C checkpoints.
.DEFAULT_GOAL := layer_pilot

PYTHON ?= python
RSCRIPT ?= Rscript
WORDSPROBABILITY ?= wordsprobability

DATASET ?= natural_stories
MODEL ?= gpt2-small
PILOT_WORDS_PER_TEXT ?= 50
PILOT_FOLDS ?= 10
PILOT_SEED ?= 42

ifneq ($(DATASET),natural_stories)
$(error MakefileLayerPilot supports only DATASET=natural_stories)
endif
ifeq ($(PILOT_WORDS_PER_TEXT),10)
PILOT_EXPECTED_ROWS := 100
else ifeq ($(PILOT_WORDS_PER_TEXT),50)
PILOT_EXPECTED_ROWS := 500
else
$(error PILOT_WORDS_PER_TEXT must be 10 or 50)
endif

MODEL_REGISTRY := src/h01_data/internal_layer_models.py
MODEL_JOINT_BUILDER := src/h01_data/build_model_joint_dataset.py
SUPPORTED_MODELS := $(shell $(PYTHON) $(MODEL_REGISTRY) --list 2>/dev/null)
ifneq ($(words $(SUPPORTED_MODELS)),10)
$(error Internal-layer registry must expose exactly ten models; activate the project environment)
endif
ifeq ($(filter $(MODEL),$(SUPPORTED_MODELS)),)
$(error Unsupported MODEL=$(MODEL); expected one of $(SUPPORTED_MODELS))
endif

REGISTRY_FINAL_LAYER := $(shell $(PYTHON) $(MODEL_REGISTRY) --model $(MODEL) --field final_layer)
REGISTRY_LAYER_IDS := $(shell $(PYTHON) $(MODEL_REGISTRY) --model $(MODEL) --field layer_ids)
REGISTRY_ANCHOR_TOLERANCE := $(shell $(PYTHON) $(MODEL_REGISTRY) --model $(MODEL) --field default_anchor_tolerance)

# Empty INTERNAL_LAYER_IDS means all transformer-block outputs. The final layer
# is fixed by the registry and must be present so the fresh reference can gate L.
INTERNAL_LAYER_IDS ?=
INTERNAL_FINAL_LAYER := $(REGISTRY_FINAL_LAYER)
FINAL_LAYER_ANCHOR_TOLERANCE ?= $(REGISTRY_ANCHOR_TOLERANCE)
ifneq ($(FINAL_LAYER_ANCHOR_TOLERANCE),$(REGISTRY_ANCHOR_TOLERANCE))
$(error canonical MODEL=$(MODEL) pilot requires FINAL_LAYER_ANCHOR_TOLERANCE=$(REGISTRY_ANCHOR_TOLERANCE))
endif
EFFECTIVE_LAYER_IDS := $(if $(strip $(INTERNAL_LAYER_IDS)),$(strip $(INTERNAL_LAYER_IDS)),$(REGISTRY_LAYER_IDS))
ifeq ($(filter $(INTERNAL_FINAL_LAYER),$(EFFECTIVE_LAYER_IDS)),)
$(error INTERNAL_LAYER_IDS must include final layer $(INTERNAL_FINAL_LAYER) for MODEL=$(MODEL))
endif

NGRAM_INDEX := v4_piletrain_llama
NGRAM_CONTEXT_LENGTHS := 0 1 2 3 4
NGRAM_BACKOFF_ALPHA := 0.4
CONTEXT_LIMITED_CONTEXT_LENGTHS := 1 2 3 4

CHECKPOINT_DIR ?= checkpoints/rt
INPUT_CHECKPOINT_DIR ?= $(CHECKPOINT_DIR)
RESULTS_DIR ?= results/rt

layer_empty :=
layer_space := $(layer_empty) $(layer_empty)
NGRAM_CONTEXT_TAG := $(subst $(layer_space),-,$(strip $(NGRAM_CONTEXT_LENGTHS)))
CONTEXT_TAG := $(subst $(layer_space),-,$(strip $(CONTEXT_LIMITED_CONTEXT_LENGTHS)))
NGRAM_ALPHA_TAG := $(subst .,_,$(NGRAM_BACKOFF_ALPHA))
INTERNAL_LAYER_TAG := $(if $(strip $(INTERNAL_LAYER_IDS)),$(subst $(layer_space),-,$(strip $(INTERNAL_LAYER_IDS))),1-$(INTERNAL_FINAL_LAYER))
INTERNAL_LAYER_ARGS := --layers $(EFFECTIVE_LAYER_IDS)

# Immutable full inputs. N and RT/controls come from the definitive GPT-2-small
# joint artifact; C comes from the selected model's completed full checkpoint.
FULL_TEXT_FILE := $(INPUT_CHECKPOINT_DIR)/text_rt_data/natural_stories.txt
CANONICAL_JOINT_TAG := natural_stories-gpt2-small-ngram_$(NGRAM_INDEX)-contexts_$(NGRAM_CONTEXT_TAG)-alpha_$(NGRAM_ALPHA_TAG)-context_$(CONTEXT_TAG)
CANONICAL_JOINT_FILE := $(INPUT_CHECKPOINT_DIR)/joint_full/$(CANONICAL_JOINT_TAG)/joint-data.tsv
MODEL_CONTEXT_TAG := natural_stories-$(MODEL)-ngram_$(NGRAM_INDEX)-contexts_$(NGRAM_CONTEXT_TAG)-alpha_$(NGRAM_ALPHA_TAG)-context_$(CONTEXT_TAG)
MODEL_CONTEXT_FILE := $(INPUT_CHECKPOINT_DIR)/joint_full/$(MODEL_CONTEXT_TAG)/context-limited.tsv

# Costly predictor identity is separate from the cheap folds/seed identity.
LAYER_CHECKPOINT_TAG := natural_stories-$(MODEL)-first_$(PILOT_WORDS_PER_TEXT)_per_text-ngram_$(NGRAM_INDEX)-contexts_$(NGRAM_CONTEXT_TAG)-alpha_$(NGRAM_ALPHA_TAG)-context_$(CONTEXT_TAG)-layers_$(INTERNAL_LAYER_TAG)-logit_lens
LAYER_ANALYSIS_TAG := folds_$(PILOT_FOLDS)-seed_$(PILOT_SEED)
LAYER_CHECKPOINT_DIR := $(CHECKPOINT_DIR)/layer_pilot/$(LAYER_CHECKPOINT_TAG)
LAYER_RESULTS_DIR := $(RESULTS_DIR)/layer_pilot/$(LAYER_CHECKPOINT_TAG)/$(LAYER_ANALYSIS_TAG)

PILOT_TEXT_FILE := $(LAYER_CHECKPOINT_DIR)/text.txt
PILOT_REFERENCE_FILE := $(LAYER_CHECKPOINT_DIR)/ordinary-surprisal.tsv
PILOT_MODEL_JOINT_FILE := $(LAYER_CHECKPOINT_DIR)/model-joint.tsv
PILOT_LAYER_FILE := $(LAYER_CHECKPOINT_DIR)/internal-layer.tsv
PILOT_ANCHOR_JSON := $(PILOT_LAYER_FILE).anchor.json
PILOT_DATA_FILE := $(LAYER_CHECKPOINT_DIR)/joint-data.tsv
PILOT_FOLD_FILE := $(LAYER_RESULTS_DIR)/fold-results.tsv
PILOT_DELTA_FILE := $(LAYER_RESULTS_DIR)/conditional-deltas.tsv
PILOT_SUMMARY_FILE := $(LAYER_RESULTS_DIR)/summary.tsv

.PHONY: layer_pilot layer_pilot_reference layer_pilot_model_joint \
        layer_pilot_surprisals layer_pilot_data layer_pilot_analysis

layer_pilot: layer_pilot_analysis
	@echo "Layer pilot complete: $(LAYER_RESULTS_DIR)"

layer_pilot_reference: $(PILOT_REFERENCE_FILE)

layer_pilot_model_joint: $(PILOT_MODEL_JOINT_FILE)

layer_pilot_surprisals: $(PILOT_LAYER_FILE) $(PILOT_ANCHOR_JSON)

layer_pilot_data: $(PILOT_DATA_FILE)

layer_pilot_analysis: $(PILOT_FOLD_FILE) $(PILOT_DELTA_FILE) $(PILOT_SUMMARY_FILE)

$(PILOT_TEXT_FILE): $(FULL_TEXT_FILE) src/h01_data/create_joint_pilot_text.py
	mkdir -p "$(LAYER_CHECKPOINT_DIR)"
	$(PYTHON) src/h01_data/create_joint_pilot_text.py \
		--input-fname "$(FULL_TEXT_FILE)" \
		--output-fname "$(PILOT_TEXT_FILE)" \
		--words-per-text $(PILOT_WORDS_PER_TEXT)

# wordsprobability does not publish atomically itself. Write beside the target
# and rename only after a complete model-specific pilot reference is available.
$(PILOT_REFERENCE_FILE): $(PILOT_TEXT_FILE)
	mkdir -p "$(LAYER_CHECKPOINT_DIR)"
	@set -eu; \
	temporary_fname="$@.tmp.$$$$"; \
	trap 'rm -f "$$temporary_fname"' EXIT HUP INT TERM; \
	$(WORDSPROBABILITY) --model "$(MODEL)" \
		--input "$(PILOT_TEXT_FILE)" \
		--output "$$temporary_fname" \
		--return-buggy-surprisals; \
	mv -f "$$temporary_fname" "$@"; \
	trap - EXIT HUP INT TERM

$(PILOT_MODEL_JOINT_FILE): $(CANONICAL_JOINT_FILE) $(MODEL_CONTEXT_FILE) \
                           $(PILOT_REFERENCE_FILE) $(MODEL_JOINT_BUILDER)
	mkdir -p "$(LAYER_CHECKPOINT_DIR)"
	$(PYTHON) $(MODEL_JOINT_BUILDER) \
		--canonical-joint-fname "$(CANONICAL_JOINT_FILE)" \
		--context-limited-surprisal-fname "$(MODEL_CONTEXT_FILE)" \
		--reference-surprisal-fname "$(PILOT_REFERENCE_FILE)" \
		--output-fname "$(PILOT_MODEL_JOINT_FILE)" \
		--expected-rows $(PILOT_EXPECTED_ROWS) \
		--words-per-text $(PILOT_WORDS_PER_TEXT)

$(PILOT_LAYER_FILE) $(PILOT_ANCHOR_JSON) &: $(PILOT_TEXT_FILE) \
        $(PILOT_REFERENCE_FILE) src/h01_data/get_internal_layer_surprisals.py \
        src/h01_data/get_context_limited_surprisals.py $(MODEL_REGISTRY)
	mkdir -p "$(LAYER_CHECKPOINT_DIR)"
	$(PYTHON) src/h01_data/get_internal_layer_surprisals.py \
		--input-fname "$(PILOT_TEXT_FILE)" \
		--output-fname "$(PILOT_LAYER_FILE)" \
		--model "$(MODEL)" $(INTERNAL_LAYER_ARGS) \
		--reference-surprisal-fname "$(PILOT_REFERENCE_FILE)" \
		--anchor-tolerance $(FINAL_LAYER_ANCHOR_TOLERANCE)

$(PILOT_DATA_FILE): $(PILOT_MODEL_JOINT_FILE) $(PILOT_LAYER_FILE) \
                    $(PILOT_ANCHOR_JSON) \
                    src/h01_data/build_layer_comparison_dataset.py \
                    src/h01_data/build_joint_pilot_dataset.py
	mkdir -p "$(LAYER_CHECKPOINT_DIR)"
	$(PYTHON) src/h01_data/build_layer_comparison_dataset.py \
		--joint-data-fname "$(PILOT_MODEL_JOINT_FILE)" \
		--internal-layer-surprisal-fname "$(PILOT_LAYER_FILE)" \
		--output-fname "$(PILOT_DATA_FILE)" \
		--require-exact-joint-coverage \
		--expected-rows $(PILOT_EXPECTED_ROWS) \
		--expected-final-layer $(INTERNAL_FINAL_LAYER) \
		--anchor-tolerance $(FINAL_LAYER_ANCHOR_TOLERANCE)

$(PILOT_FOLD_FILE) $(PILOT_DELTA_FILE) $(PILOT_SUMMARY_FILE) &: \
        $(PILOT_DATA_FILE) src/h02_rt_model/rt_vs_internal_layer_surprisal.R \
        src/h02_rt_model/rt_vs_joint_pilot_surprisal.R
	mkdir -p "$(LAYER_RESULTS_DIR)"
	$(RSCRIPT) src/h02_rt_model/rt_vs_internal_layer_surprisal.R \
		"$(PILOT_DATA_FILE)" "$(PILOT_FOLD_FILE)" \
		"$(PILOT_DELTA_FILE)" "$(PILOT_SUMMARY_FILE)" \
		$(PILOT_FOLDS) $(PILOT_SEED) "$(MODEL)"
