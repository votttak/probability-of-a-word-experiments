# CONTEXT-LIMITED: Keep the established Makefile as the source of truth for
# datasets, full-context LM surprisals, preprocessing, and lexical controls.
# This file adds an explicit fixed-word-context branch only.
.DEFAULT_GOAL := context_limited
include Makefile

# CONTEXT-LIMITED: Each value is the maximum number of preceding project words
# retained for the target.  The scorer loads MODEL once for all listed values.
CONTEXT_LIMITED_CONTEXT_LENGTHS ?= 1 2 4
CONTEXT_LIMITED_BATCH_SIZE ?= 8

# CONTEXT-LIMITED: Encode all score-defining settings in checkpoint names so
# Make cannot reuse results generated with a different set of word windows.
context_limited_empty :=
context_limited_space := $(context_limited_empty) $(context_limited_empty)
CONTEXT_LIMITED_CONTEXT_TAG := $(subst $(context_limited_space),-,$(strip $(CONTEXT_LIMITED_CONTEXT_LENGTHS)))
CONTEXT_LIMITED_CONFIG_TAG := contexts_$(CONTEXT_LIMITED_CONTEXT_TAG)

# CONTEXT-LIMITED: Predictor checkpoints are model-specific; derived RT data,
# fitted parameters, and held-out likelihoods use their own opt-in directories.
CONTEXT_LIMITED_SURPRISALS_DIR := $(CHECKPOINT_DIR)/context_limited_surprisals_rt_data/
CONTEXT_LIMITED_MERGED_DATA_DIR := $(CHECKPOINT_DIR)/merged_context_limited_data/
CONTEXT_LIMITED_PARAMS_DIR := $(CHECKPOINT_DIR)/context_limited_params/
CONTEXT_LIMITED_DELTA_LLH_DIR := $(CHECKPOINT_DIR)/context_limited_delta_llh/

CONTEXT_LIMITED_SURPRISALS_FILE := $(CONTEXT_LIMITED_SURPRISALS_DIR)/context-limited-$(DATASET)-$(MODEL)-$(CONTEXT_LIMITED_CONFIG_TAG).tsv
CONTEXT_LIMITED_MERGED_DATA_FILE := $(CONTEXT_LIMITED_MERGED_DATA_DIR)/$(DATASET)-$(MODEL)-$(CONTEXT_LIMITED_CONFIG_TAG).tsv
CONTEXT_LIMITED_ANALYSIS_PARAMS_FNAME_BASE := $(CONTEXT_LIMITED_PARAMS_DIR)/params-$(DATASET)-$(MODEL)-$(CONTEXT_LIMITED_CONFIG_TAG)
CONTEXT_LIMITED_LLH_FILE := $(CONTEXT_LIMITED_DELTA_LLH_DIR)/llh-$(DATASET)-$(MODEL)-$(CONTEXT_LIMITED_CONFIG_TAG).tsv

# CONTEXT-LIMITED: These entry points leave every original Make target and
# every n-gram target unchanged unless this Makefile is selected explicitly.
.PHONY: context_limited process_context_limited_data get_context_limited_llh
context_limited: get_context_limited_llh

process_context_limited_data: $(CONTEXT_LIMITED_MERGED_DATA_FILE)

get_context_limited_llh: $(CONTEXT_LIMITED_LLH_FILE)

# CONTEXT-LIMITED: Run the dedicated fixed-window analysis with the same R
# helpers and controls as the original full-context experiment.
$(CONTEXT_LIMITED_LLH_FILE): $(CONTEXT_LIMITED_MERGED_DATA_FILE) \
                              src/h02_rt_model/rt_vs_context_limited_surprisal.R \
                              src/h02_rt_model/r_utils.R \
                              src/h02_rt_model/predictors.R \
                              src/h02_rt_model/baselines.R
	mkdir -p $(CONTEXT_LIMITED_PARAMS_DIR)
	mkdir -p $(CONTEXT_LIMITED_DELTA_LLH_DIR)
	Rscript src/h02_rt_model/rt_vs_context_limited_surprisal.R $(CONTEXT_LIMITED_MERGED_DATA_FILE) $(CONTEXT_LIMITED_LLH_FILE) $(CONTEXT_LIMITED_ANALYSIS_PARAMS_FNAME_BASE) --merge-workers --is-linear

# CONTEXT-LIMITED: Merge on zero-based text/word IDs, validate exact coverage
# and word equality, then create current and three spillover positions.
$(CONTEXT_LIMITED_MERGED_DATA_FILE): $(PREPROCESSED_RT_FILE) \
                                     $(SURPRISALS_FILE) \
                                     $(CONTEXT_LIMITED_SURPRISALS_FILE) \
                                     src/h01_data/get_rt_with_surprisal_dataset.py
	mkdir -p $(CONTEXT_LIMITED_MERGED_DATA_DIR)
	python src/h01_data/get_rt_with_surprisal_dataset.py \
		--rt-fname $(PREPROCESSED_RT_FILE) \
		--surprisal-fname $(SURPRISALS_FILE) \
		--context-limited-surprisal-fname $(CONTEXT_LIMITED_SURPRISALS_FILE) \
		--output-fname $(CONTEXT_LIMITED_MERGED_DATA_FILE)

# CONTEXT-LIMITED: Score every requested word window in one model-loading run;
# atomic output prevents a failed inference job from becoming a Make target.
$(CONTEXT_LIMITED_SURPRISALS_FILE): $(TEXT_RT_FILE) \
                                     src/h01_data/get_context_limited_surprisals.py
	mkdir -p $(CONTEXT_LIMITED_SURPRISALS_DIR)
	python src/h01_data/get_context_limited_surprisals.py \
		--input-fname $(TEXT_RT_FILE) \
		--output-fname $(CONTEXT_LIMITED_SURPRISALS_FILE) \
		--model $(MODEL) \
		--context-lengths $(CONTEXT_LIMITED_CONTEXT_LENGTHS) \
		--batch-size $(CONTEXT_LIMITED_BATCH_SIZE)
