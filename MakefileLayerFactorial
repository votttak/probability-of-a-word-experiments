# Isolated replication diagnostic:
# extraction context (passage/sentence) x score (corrected/buggy)
# x decoder (logit/tuned lens). Existing layer_full artifacts are untouched.
.DEFAULT_GOAL := layer_factorial_pivot

PYTHON ?= python
RSCRIPT ?= Rscript
LAYER_FACTORIAL_CONFIG ?= configs/layer_factorial.json
LAYER_FACTORIAL_CONFIG_TOOL := src/h01_data/layer_factorial_config.py
MODEL ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --list-models | sed -n '1p')
FACTORIAL_JOBS ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --get runtime.jobs)
FACTORIAL_THREADS_PER_JOB ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --get runtime.threads_per_job)
PIVOT_SENTENCES_PER_TEXT ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --get runtime.pivot_sentences_per_text)

CHECKPOINT_ROOT ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path local_checkpoint_root)
RESULTS_ROOT ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path local_results_root)
NATURAL_STORIES_SOURCE ?= .cache/naturalstories-source
ALIGNED_CONLLX := $(NATURAL_STORIES_SOURCE)/parses/ud/stories-aligned.conllx
FULL_TEXT_FILE := $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path text)
FULL_SENTENCE_MANIFEST := $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path sentence_manifest)
PAPER_RT_FILE ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path paper_rt)
PAPER_FREQUENCY_FILE ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path precomputed_frequency)
CANONICAL_JOINT_FILE ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_CONFIG_TOOL) --config "$(LAYER_FACTORIAL_CONFIG)" --resolve-path joint_template --model "$(MODEL)")

# These are explicit local resources. The scorer verifies artifact hashes,
# architecture, base name, layer count, width, and exact base revision.
LAYER_FACTORIAL_MODEL_REGISTRY := src/h01_data/layer_factorial_models.py
TUNED_LENS_ARTIFACT ?= $(shell $(PYTHON) $(LAYER_FACTORIAL_MODEL_REGISTRY) --model "$(MODEL)" --field lens_artifact)
TUNED_LENS_PATH ?= .cache/tuned-lens-repo/lens/$(TUNED_LENS_ARTIFACT)
TUNED_LENS_PYTHONPATH ?= .cache/python/tuned-lens-0.2.0
WORDFREQ_PYTHONPATH ?= .cache/python/wordfreq-3.1.1

PIVOT_TAG := pivot-$(MODEL)
PIVOT_INPUT_DIR := $(CHECKPOINT_ROOT)/$(PIVOT_TAG)/input
PIVOT_TEXT_FILE := $(PIVOT_INPUT_DIR)/text.txt
PIVOT_SENTENCE_MANIFEST := $(PIVOT_INPUT_DIR)/sentences.tsv
PIVOT_JOINT_FILE := $(PIVOT_INPUT_DIR)/joint-data.tsv
PIVOT_SELECTION_JSON := $(PIVOT_INPUT_DIR)/selection.json
PIVOT_OUTPUTS := $(PIVOT_TEXT_FILE) $(PIVOT_SENTENCE_MANIFEST) $(PIVOT_JOINT_FILE) $(PIVOT_SELECTION_JSON)

.PHONY: FORCE layer_factorial_inputs layer_factorial_manifest layer_factorial_regenerate_manifest layer_factorial_pivot layer_factorial_full

FORCE:

layer_factorial_inputs: $(LAYER_FACTORIAL_CONFIG) $(FULL_SENTENCE_MANIFEST) $(PAPER_RT_FILE) $(PAPER_FREQUENCY_FILE)
	$(PYTHON) scripts/prepare_layer_factorial_inputs.py --verify-only --paper-output-fname "$(PAPER_RT_FILE)" --frequency-output-fname "$(PAPER_FREQUENCY_FILE)"

layer_factorial_manifest: $(FULL_SENTENCE_MANIFEST)
	@echo "Sentence manifest ready: $(FULL_SENTENCE_MANIFEST)"

layer_factorial_regenerate_manifest: $(ALIGNED_CONLLX) $(FULL_TEXT_FILE) src/h01_data/build_natural_stories_sentence_manifest.py
	$(PYTHON) src/h01_data/build_natural_stories_sentence_manifest.py --aligned-conllx-fname "$(ALIGNED_CONLLX)" --canonical-passage-fname "$(FULL_TEXT_FILE)" --output-fname "$(FULL_SENTENCE_MANIFEST)"

$(PIVOT_OUTPUTS) &: FORCE $(LAYER_FACTORIAL_CONFIG) $(FULL_TEXT_FILE) $(FULL_SENTENCE_MANIFEST) $(CANONICAL_JOINT_FILE) src/h01_data/build_layer_factorial_pivot.py
	$(PYTHON) src/h01_data/build_layer_factorial_pivot.py --text-fname "$(FULL_TEXT_FILE)" --sentence-manifest-fname "$(FULL_SENTENCE_MANIFEST)" --joint-data-fname "$(CANONICAL_JOINT_FILE)" --sentences-per-text $(PIVOT_SENTENCES_PER_TEXT) --output-text-fname "$(PIVOT_TEXT_FILE)" --output-sentence-manifest-fname "$(PIVOT_SENTENCE_MANIFEST)" --output-joint-data-fname "$(PIVOT_JOINT_FILE)" --output-metadata-fname "$(PIVOT_SELECTION_JSON)"

layer_factorial_pivot: $(PIVOT_OUTPUTS)
	$(PYTHON) scripts/run_layer_factorial.py --config "$(LAYER_FACTORIAL_CONFIG)" --model "$(MODEL)" --text-fname "$(PIVOT_TEXT_FILE)" --sentence-manifest-fname "$(PIVOT_SENTENCE_MANIFEST)" --joint-data-fname "$(PIVOT_JOINT_FILE)" --paper-rt-fname "$(PAPER_RT_FILE)" --tuned-lens-path "$(TUNED_LENS_PATH)" --tuned-lens-pythonpath "$(TUNED_LENS_PYTHONPATH)" --wordfreq-pythonpath "$(WORDFREQ_PYTHONPATH)" --checkpoint-root "$(CHECKPOINT_ROOT)/$(PIVOT_TAG)/run" --results-root "$(RESULTS_ROOT)/$(PIVOT_TAG)/run" --python "$(PYTHON)" --rscript "$(RSCRIPT)" --jobs $(FACTORIAL_JOBS) --threads-per-job $(FACTORIAL_THREADS_PER_JOB) --report-note "Local pivot: first $(PIVOT_SENTENCES_PER_TEXT) complete sentences from each Natural Stories text. Use this only as a directional diagnostic."

layer_factorial_full: layer_factorial_inputs
	$(PYTHON) scripts/run_layer_factorial.py --config "$(LAYER_FACTORIAL_CONFIG)" --model "$(MODEL)" --tuned-lens-path "$(TUNED_LENS_PATH)" --tuned-lens-pythonpath "$(TUNED_LENS_PYTHONPATH)" --checkpoint-root "$(CHECKPOINT_ROOT)/full-$(MODEL)" --results-root "$(RESULTS_ROOT)/full-$(MODEL)" --python "$(PYTHON)" --rscript "$(RSCRIPT)" --jobs $(FACTORIAL_JOBS) --threads-per-job $(FACTORIAL_THREADS_PER_JOB)
